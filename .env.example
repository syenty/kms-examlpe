# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=userdb

# KMS Configuration
KMS_URL=http://localhost:9998

# KMS Key IDs (get these from KMS UI after creating keys)
# Symmetric key for data encryption
KMS_SYMMETRIC_KEY_ID=

# RSA key pair (optional, for future use)
KMS_RSA_KEY_ID=

# Fallback: Local encryption master key (used when KMS is not configured)
# ENCRYPTION_MASTER_KEY=
