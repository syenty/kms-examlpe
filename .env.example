# Environment
# local: 로컬 개발 환경 (synchronize=true, logging=true)
# development: 개발 서버 환경 (synchronize=true, logging=true)
# production: 프로덕션 환경 (synchronize=false, logging=false)
NODE_ENV=local

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=userdb

# KMS Configuration (REQUIRED)
KMS_URL=http://localhost:9998

# KMS Key IDs (get these from KMS UI after creating keys)
# REQUIRED: Symmetric key for data encryption
# Application will not start without this key!
KMS_SYMMETRIC_KEY_ID=

# Optional: RSA key pair (for future use)
KMS_RSA_KEY_ID=
